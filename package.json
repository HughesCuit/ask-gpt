{
  "name": "gpt-web-bridge",
  "version": "1.0.6",
  "description": "Unofficial browser bridge to a logged-in ChatGPT web session for coding agents. Temporary chats, JSON output, profile lock, debug bundles.",
  "type": "module",
  "bin": {
    "gpt-web-bridge": "bin/web-gpt.js",
    "web-gpt": "bin/web-gpt.js",
    "ask-gpt": "bin/web-gpt.js"
  },
  "files": [
    "bin",
    "src",
    "selectors.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "node --check src/cli.mjs && node src/cli.mjs --help && node src/cli.mjs --version"
  },
  "keywords": [
    "gpt-web-bridge",
    "web-gpt",
    "ask-gpt",
    "chatgpt",
    "openai",
    "coding-agent",
    "browser-automation",
    "playwright",
    "ai-agent",
    "cli",
    "second-opinion"
  ],
  "author": "HughesCuit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heventure/gpt-web-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/heventure/gpt-web-bridge/issues"
  },
  "homepage": "https://github.com/heventure/gpt-web-bridge#readme",
  "dependencies": {
    "playwright-core": "^1.49.0"
  }
}
